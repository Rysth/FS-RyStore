# Server Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# Nombre de marca en los correos (asunto, cabecera, pie) y en better-auth.
APP_NAME=R&R Template
# OBLIGATORIO: genera un valor único por despliegue con `openssl rand -hex 64`.
# Firma las cookies de sesión y los tokens de verificación/reset. Nunca reutilices
# este valor entre clientes ni dejes el placeholder. Mínimo 32 caracteres: la API
# no arranca con un valor más corto.
SECRET_KEY_BASE=

# Database configuration
# Estas variables configuran tanto el servicio `postgres` como la DATABASE_URL
# de `api` y `worker`, así que hay un único nombre para cada cosa.
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=postgres
# Internal default Postgres port is 5432; variable no longer required in compose
# DB_PORT=5432
DB_NAME=template_development

# Admin panel configuration
ADMIN_FRONTEND_URL=http://localhost:5173
ADMIN_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:3000

# SMTP (generic; supports custom infra)
# For implicit TLS use port 465; for STARTTLS use 587.
# En desarrollo el compose ignora estos valores y enruta el correo a mailpit
# (bandeja en http://localhost:8025).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=support@rysthdesign.com
SMTP_PASSWORD=your_secure_smtp_password
# Remitente de los correos salientes; por defecto SMTP_USER.
# SMTP_FROM=no-reply@example.com

# Primer administrador (api/scripts/create-admin.ts). Sin ADMIN_PASSWORD se
# genera una contraseña fuerte y se muestra una sola vez.
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_me_strong_password

# Contraseña de las cuentas de prueba que crea `npm run db:seed:dev`
# (solo desarrollo/test). Por defecto: password123
# DEV_SEED_PASSWORD=password123

# User permissions (Linux/Mac)
DOCKER_UID=1000
DOCKER_GID=1000

# Cloudflare R2 (almacenamiento del logo del negocio)
CLOUDFLARE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_BUCKET_NAME=noviSchool-assets
# Dominio público del bucket; si se omite se compone desde el endpoint.
# CLOUDFLARE_PUBLIC_URL=https://assets.example.com

# Producción con Traefik (docker-compose.yml)
# ADMIN_SERVER_NAME=admin.example.com
# API_UPSTREAM_SCHEME=https
# API_UPSTREAM_HOST=api.example.com
# API_UPSTREAM_PORT=443

# Migración de datos desde el backend Rails (una sola vez, ver api/scripts/
# migrate-from-rails.ts). Solo hace falta en despliegues que ya tienen datos
# de Rodauth; una instalación nueva no la necesita.
# RAILS_DATABASE_URL=postgres://postgres:password@postgres:5432/rails_api_development
