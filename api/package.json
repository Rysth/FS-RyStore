{
  "name": "@rr/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "worker": "node src/jobs/worker.ts",
    "console": "node scripts/console.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --test test/**/*.test.ts",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "node src/db/migrate.ts",
    "migrate:from-rails": "node scripts/migrate-from-rails.ts",
    "db:seed": "node src/db/seed.ts",
    "db:seed:dev": "node src/db/seed-dev.ts",
    "create-admin": "node scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^4.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.9.0"
  }
}
