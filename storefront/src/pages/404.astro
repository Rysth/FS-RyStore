---
import StoreLayout from "../layouts/StoreLayout.astro";
---

<StoreLayout title="Página no encontrada" noindex>
  <div class="mx-auto flex w-full max-w-md flex-col items-center gap-4 px-4 py-20 text-center">
    <p class="text-5xl font-bold" style="color: var(--rystore-primary)">404</p>
    <h1 class="text-xl font-bold">No encontramos esta página</h1>
    <p class="text-sm text-muted-foreground">
      Puede que el producto ya no esté disponible o el enlace haya cambiado.
    </p>
    <a
      href="/"
      class="rounded-full px-5 py-2.5 text-sm font-semibold text-white"
      style="background-color: var(--rystore-primary)"
    >
      Volver al catálogo
    </a>
  </div>
</StoreLayout>
