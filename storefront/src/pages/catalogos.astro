---
import StoreLayout from "../layouts/StoreLayout.astro";
import { fetchDownloadableCatalogs, fetchSettings } from "../lib/api";
import type { DownloadableCatalog, StoreSettings } from "../types/store";

let settings: StoreSettings | null = null;
let catalogs: DownloadableCatalog[] = [];
let loadError: string | null = null;

try {
  settings = (await fetchSettings()).store;
  catalogs = (await fetchDownloadableCatalogs()).downloadable_catalogs;
} catch (error) {
  loadError = error instanceof Error ? error.message : "No pudimos cargar los catálogos.";
}
---

<StoreLayout title="Descargar catálogos" storeSettings={settings} closed={false}>
  <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:py-14">
    <div class="mb-8 max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--rystore-primary)">
        Catálogos
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Descargar catálogos</h1>
      <p class="mt-3 text-sm leading-7 text-muted-foreground sm:text-base">
        Revisa nuestras promociones, listas y campañas en PDF. Puedes abrirlos o descargarlos para verlos con calma.
      </p>
    </div>

    {loadError ? (
      <p class="rounded-xl bg-destructive/10 px-4 py-3 text-sm text-destructive">{loadError}</p>
    ) : catalogs.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {catalogs.map((catalog) => (
          <article class="group overflow-hidden rounded-3xl border border-border/60 bg-card shadow-sm transition-transform hover:-translate-y-1">
            <a href={catalog.file_url} target="_blank" rel="noopener noreferrer" class="block">
              <div class="flex aspect-[4/3] items-center justify-center bg-muted/50">
                {catalog.cover_image_url ? (
                  <img src={catalog.cover_image_url} alt={catalog.title} class="size-full object-cover transition-transform duration-300 group-hover:scale-105" />
                ) : (
                  <span class="rounded-full bg-background px-4 py-2 text-sm font-semibold text-muted-foreground">PDF</span>
                )}
              </div>
              <div class="space-y-3 p-5">
                <h2 class="text-lg font-bold">{catalog.title}</h2>
                {catalog.description && <p class="text-sm leading-6 text-muted-foreground">{catalog.description}</p>}
                <span class="inline-flex rounded-full px-4 py-2 text-sm font-semibold text-white" style="background-color: var(--rystore-primary)">
                  Ver catálogo
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="rounded-3xl border border-dashed border-border p-8 text-center">
        <h2 class="text-lg font-semibold">No hay catálogos publicados</h2>
        <p class="mt-2 text-sm text-muted-foreground">Vuelve pronto para revisar nuevos archivos.</p>
      </div>
    )}
  </div>
</StoreLayout>
