---
import StoreLayout from "../layouts/StoreLayout.astro";
import { fetchBranches, fetchSettings } from "../lib/api";
import type { StoreBranch, StoreSettings } from "../types/store";

let settings: StoreSettings | null = null;
let branches: StoreBranch[] = [];
let loadError: string | null = null;

try {
  settings = (await fetchSettings()).store;
  try {
    branches = (await fetchBranches()).branches;
  } catch (error) {
    console.error("[storefront] /api/v1/public/branches failed", error);
  }
} catch (error) {
  loadError = error instanceof Error ? error.message : "No pudimos cargar esta página.";
}

const shopName = settings?.name || "RyStore";
const title = settings?.about_title || `Sobre ${shopName}`;
const body = settings?.about_body || settings?.slogan || "Conoce más sobre nuestra tienda y lo que ofrecemos.";
const paragraphs = body.split(/\n{2,}/).map((item) => item.trim()).filter(Boolean);
---

<StoreLayout title="Sobre nosotros" storeSettings={settings} closed={false}>
  <div class="mx-auto w-full max-w-6xl px-4 py-10 sm:py-14">
    {loadError ? (
      <p class="rounded-xl bg-destructive/10 px-4 py-3 text-sm text-destructive">{loadError}</p>
    ) : (
      <div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-start">
        <section class="rounded-3xl border border-border/60 bg-card p-6 shadow-sm sm:p-8">
          <p class="text-sm font-semibold uppercase tracking-wide" style="color: var(--rystore-primary)">
            Nuestra historia
          </p>
          <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
          <div class="mt-5 space-y-4 text-sm leading-7 text-muted-foreground sm:text-base">
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <aside class="rounded-3xl bg-muted/40 p-6">
          <h2 class="text-lg font-semibold">También puedes visitarnos</h2>
          {branches.length > 0 ? (
            <div class="mt-4 space-y-3">
              {branches.slice(0, 3).map((branch) => (
                <article class="rounded-2xl bg-background p-4 shadow-sm">
                  <h3 class="font-semibold">{branch.name}</h3>
                  {branch.address && <p class="mt-1 text-sm text-muted-foreground">{branch.address}</p>}
                  {branch.maps_url && (
                    <a href={branch.maps_url} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-medium hover:underline" style="color: var(--rystore-primary)">
                      Cómo llegar
                    </a>
                  )}
                </article>
              ))}
            </div>
          ) : (
            <p class="mt-3 text-sm text-muted-foreground">Escríbenos para coordinar tu visita o compra.</p>
          )}
          <a href="/contacto" class="mt-5 inline-flex rounded-full px-4 py-2 text-sm font-semibold text-white" style="background-color: var(--rystore-primary)">
            Ver contacto
          </a>
        </aside>
      </div>
    )}
  </div>
</StoreLayout>
