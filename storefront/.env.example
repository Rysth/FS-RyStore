# Storefront (Astro SSR)

# Canonical public origin — canonical links, Open Graph urls and the sitemap.
STOREFRONT_URL=http://localhost:4321

# API base used during server-side rendering (compose network, no CORS).
# Use the api container's container_name ("${STACK_NAME}-api"), not the compose
# service name "api" — on a shared network another stack's own "api" service
# can grab that alias too, causing intermittent 403s.
API_INTERNAL_URL=http://rystore-api:3000

# API base used from the buyer's browser. This origin must match the API's
# STOREFRONT_URL (or be listed in STOREFRONT_ALLOWED_ORIGINS) so the /public
# CORS block lets the checkout through.
#
# Inlined into the client bundle at build time, so docker-compose.yml passes it
# as a build arg — setting it only at runtime leaves the checkout calling an
# empty origin.
PUBLIC_API_URL=http://localhost:3000

# Vertical pública: "store" para RyStore, "restaurant" para menú digital/HungerApp.
PUBLIC_APP_VERTICAL=store
